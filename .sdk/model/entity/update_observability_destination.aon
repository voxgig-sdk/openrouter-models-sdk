# Entity: update_observability_destination

main: kit: entity: update_observability_destination: {

  alias: field: {}

  fields: [
    {
      name: "api_key_hashes"
      req: false
      short: "Optional allowlist of OpenRouter API key hashes."
      type: [
        "`$ONE`"
        [
          "`$ARRAY`"
          "`$NULL`"
        ]
      ]
    }
    {
      name: "config"
      req: false
      short: "Provider-specific configuration fields to update."
      type: "`$OBJECT`"
    }
    {
      name: "enabled"
      req: false
      short: "Whether the destination is enabled."
      type: "`$BOOLEAN`"
    }
    {
      name: "filter_rules"
      req: false
      type: "`$ANY`"
      union: {
        branches: 2
        count: 1
        depth: 10
      }
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "name"
      req: false
      short: "Human-readable name for the destination."
      type: "`$STRING`"
    }
    {
      name: "privacy_mode"
      req: false
      short: "When true, request/response bodies are not forwarded — only metadata."
      type: "`$BOOLEAN`"
    }
    {
      format: "double"
      name: "sampling_rate"
      req: false
      short: "Sampling rate between 0.0001 and 1 (1 = 100%)."
      type: "`$NUMBER`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "update_observability_destination"
  op: {
    update: {
      name: "update"
      points: [
        {
          args: {
            header: [
              {
                kind: "header"
                name: "http_referer"
                orig: "http_referer"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "header"
                name: "x_open_router_category"
                orig: "x_open_router_category"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "header"
                name: "x_open_router_title"
                orig: "x_open_router_title"
                reqd: false
                type: "`$STRING`"
              }
            ]
            params: [
              {
                example: "99999999-aaaa-bbbb-cccc-dddddddddddd"
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "PATCH"
          orig: "/observability/destinations/{id}"
          segments: [
            {
              lit: "observability"
            }
            {
              lit: "destinations"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "http_referer"
              "id"
              "x_open_router_category"
              "x_open_router_title"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
  }



}
