# Entity: tts

main: kit: entity: tts: {

  alias: field: {}

  fields: [
    {
      name: "input"
      req: true
      type: "`$STRING`"
    }
    {
      name: "model"
      req: true
      type: "`$STRING`"
    }
    {
      name: "provider"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "response_format"
      req: false
      type: "`$STRING`"
    }
    {
      name: "speed"
      req: false
      type: "`$NUMBER`"
    }
    {
      name: "voice"
      req: true
      type: "`$STRING`"
    }
  ]

  name: "tts"
  op: {
    create: {
      name: "create"
      points: [
        {
          args: {
            header: [
              {
                kind: "header"
                name: "http_referer"
                orig: "http_referer"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "header"
                name: "x_open_router_category"
                orig: "x_open_router_category"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "header"
                name: "x_open_router_title"
                orig: "x_open_router_title"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "POST"
          orig: "/audio/speech"
          parts: [
            "audio"
            "speech"
          ]
          select: {
            exist: [
              "http_referer"
              "x_open_router_category"
              "x_open_router_title"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
