              var: "id"
            }
          ]
          select: {
            exist: [
              "http_referer"
              "id"
              "x_open_router_category"
              "x_open_router_title"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
