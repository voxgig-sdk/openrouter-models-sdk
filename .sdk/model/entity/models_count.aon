# Entity: models_count

main: kit: entity: models_count: {

  alias: field: {}

  fields: [
    {
      name: "count"
      req: true
      short: "Total number of available models"
      type: "`$INTEGER`"
    }
  ]

  name: "models_count"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            header: [
              {
                kind: "header"
                name: "http_referer"
                orig: "http_referer"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "header"
                name: "x_open_router_category"
                orig: "x_open_router_category"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "header"
                name: "x_open_router_title"
                orig: "x_open_router_title"
                reqd: false
                type: "`$STRING`"
              }
            ]
            query: [
              {
                example: "text"
                kind: "query"
                name: "output_modality"
                orig: "output_modality"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/models/count"
          segments: [
            {
              lit: "models"
            }
            {
              lit: "count"
            }
          ]
          select: {
            exist: [
              "http_referer"
              "output_modality"
              "x_open_router_category"
              "x_open_router_title"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
  }



}
