# Entity: credit

main: kit: entity: credit: {

  alias: field: {}

  fields: [
    {
      format: "double"
      name: "total_credits"
      req: true
      short: "Total credits purchased"
      type: "`$NUMBER`"
    }
    {
      format: "double"
      name: "total_usage"
      req: true
      short: "Total credits used"
      type: "`$NUMBER`"
    }
  ]

  name: "credit"
  op: {
    create: {
      name: "create"
      points: [
        {
          args: {
            header: [
              {
                kind: "header"
                name: "http_referer"
                orig: "http_referer"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "header"
                name: "x_open_router_category"
                orig: "x_open_router_category"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "header"
                name: "x_open_router_title"
                orig: "x_open_router_title"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "POST"
          orig: "/credits/coinbase"
          segments: [
            {
              lit: "credits"
            }
            {
              lit: "coinbase"
            }
          ]
          select: {
            "$action": "coinbase"
            exist: [
              "http_referer"
              "x_open_router_category"
              "x_open_router_title"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            header: [
              {
                kind: "header"
                name: "http_referer"
                orig: "http_referer"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "header"
                name: "x_open_router_category"
                orig: "x_open_router_category"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "header"
                name: "x_open_router_title"
                orig: "x_open_router_title"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/credits"
          segments: [
            {
              lit: "credits"
            }
          ]
          select: {
            exist: [
              "http_referer"
              "x_open_router_category"
              "x_open_router_title"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
  }



}
