# Entity: bulk_remove_workspace_member

main: kit: entity: bulk_remove_workspace_member: {

  alias: field: {}

  fields: [
    {
      name: "removed_count"
      req: true
      short: "Number of members removed"
      type: "`$INTEGER`"
    }
    {
      name: "user_ids"
      req: true
      short: "List of user IDs to remove from the workspace"
      type: "`$ARRAY`"
    }
  ]

  name: "bulk_remove_workspace_member"
  op: {
    create: {
      name: "create"
      points: [
        {
          args: {
            header: [
              {
                kind: "header"
                name: "http_referer"
                orig: "http_referer"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "header"
                name: "x_open_router_category"
                orig: "x_open_router_category"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "header"
                name: "x_open_router_title"
                orig: "x_open_router_title"
                reqd: false
                type: "`$STRING`"
              }
            ]
            params: [
              {
                example: "production"
                kind: "param"
                name: "workspace_id"
                orig: "id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "POST"
          orig: "/workspaces/{id}/members/remove"
          parts: [
            "workspaces"
            "{workspace_id}"
            "members"
            "remove"
          ]
          rename: {
            param: {
              id: "workspace_id"
            }
          }
          select: {
            exist: [
              "http_referer"
              "workspace_id"
              "x_open_router_category"
              "x_open_router_title"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "workspace"
      ]
    ]
  }



}
