# Entity: image

main: kit: entity: image: {

  alias: field: {}

  fields: {
    aspect_ratio: {
      h: "Aspect Ratio"
      n: "aspect_ratio"
      r: false
      sh: "Normalized aspect ratio of the generated image."
      t: "`$STRING`"
    }
    background: {
      h: "Background"
      n: "background"
      r: false
      sh: "Background treatment."
      t: "`$STRING`"
    }
    created: {
      h: "Created"
      n: "created"
      r: true
      sh: "Unix timestamp (seconds) when the image was generated"
      t: "`$INTEGER`"
    }
    data: {
      h: "Data"
      n: "data"
      r: true
      sh: "Generated images"
      t: "`$ARRAY`"
    }
    input_references: {
      h: "Input References"
      n: "input_references"
      r: false
      sh: "Reference images to guide image-to-image generation, as base64 data URLs or HTTP(S) URLs."
      t: "`$ARRAY`"
    }
    model: {
      h: "Model"
      n: "model"
      r: true
      sh: "The image generation model to use"
      t: "`$STRING`"
    }
    n: {
      h: "N"
      n: "n"
      r: false
      sh: "Number of images to generate (1-10)."
      t: "`$INTEGER`"
    }
    output_compression: {
      h: "Output Compression"
      n: "output_compression"
      r: false
      sh: "Compression level (0-100) for webp/jpeg output."
      t: "`$INTEGER`"
    }
    output_format: {
      h: "Output Format"
      n: "output_format"
      r: false
      sh: "Encoding of the returned image bytes."
      t: "`$STRING`"
    }
    prompt: {
      h: "Prompt"
      n: "prompt"
      r: true
      sh: "Text description of the desired image"
      t: "`$STRING`"
    }
    provider: {
      h: "Provider"
      n: "provider"
      r: false
      sh: "Provider routing preferences and provider-specific passthrough configuration."
      t: "`$OBJECT`"
      union: {
        branches: 2
        count: 4
        depth: 3
      }
    }
    quality: {
      h: "Quality"
      n: "quality"
      r: false
      sh: "Rendering quality."
      t: "`$STRING`"
    }
    resolution: {
      h: "Resolution"
      n: "resolution"
      r: false
      sh: "Normalized resolution tier of the generated image."
      t: "`$STRING`"
    }
    seed: {
      h: "Seed"
      n: "seed"
      r: false
      sh: "If specified, the generation will sample deterministically, such that repeated requests with the same seed and parameters should return the same result."
      t: "`$INTEGER`"
    }
    size: {
      h: "Size"
      n: "size"
      r: false
      sh: "Optional."
      t: "`$STRING`"
    }
    stream: {
      h: "Stream"
      n: "stream"
      r: false
      sh: "If true, partial images are streamed as SSE events as they become available."
      t: "`$BOOLEAN`"
    }
    usage: {
      h: "Usage"
      n: "usage"
      r: true
      sh: "Token and cost usage for the image generation request, when available"
      t: "`$OBJECT`"
      union: {
        branches: 4
        count: 1
        depth: 3
      }
    }
  }

  name: "image"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST /images"
            source: "openapi3"
            version: 2
          }
          g: {
            header: [
              {
                k: "header"
                n: "http_referer"
                or: "http_referer"
                r: false
                t: "`$STRING`"
              }
              {
                k: "header"
                n: "x_open_router_category"
                or: "x_open_router_category"
                r: false
                t: "`$STRING`"
              }
              {
                k: "header"
                n: "x_open_router_title"
                or: "x_open_router_title"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "POST"
          o: "/images"
          q: {
            exist: [
              "http_referer"
              "x_open_router_category"
              "x_open_router_title"
            ]
          }
          s: [
            {
              lit: "images"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
