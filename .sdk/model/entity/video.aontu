# Entity: video

main: kit: entity: video: {

  alias: field: {}

  fields: [
    {
      name: "aspect_ratio"
      req: false
      type: "`$STRING`"
    }
    {
      name: "callback_url"
      req: false
      type: "`$STRING`"
    }
    {
      name: "duration"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "error"
      req: false
      type: "`$STRING`"
    }
    {
      name: "frame_images"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "generate_audio"
      req: false
      type: "`$BOOLEAN`"
    }
    {
      name: "generation_id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "id"
      req: true
      type: "`$STRING`"
    }
    {
      name: "input_references"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "model"
      req: true
      type: "`$STRING`"
    }
    {
      name: "polling_url"
      req: true
      type: "`$STRING`"
    }
    {
      name: "prompt"
      req: false
      type: "`$STRING`"
    }
    {
      name: "provider"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "resolution"
      req: false
      type: "`$STRING`"
    }
    {
      name: "seed"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "size"
      req: false
      type: "`$STRING`"
    }
    {
      name: "status"
      req: true
      type: "`$STRING`"
    }
    {
      name: "unsigned_urls"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "usage"
      req: false
      type: "`$OBJECT`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "video"
  op: {
    create: {
      name: "create"
      points: [
        {
          args: {
            header: [
              {
                kind: "header"
                name: "http_referer"
                orig: "http_referer"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "header"
                name: "x_open_router_category"
                orig: "x_open_router_category"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "header"
                name: "x_open_router_title"
                orig: "x_open_router_title"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "POST"
          orig: "/videos"
          parts: [
            "videos"
          ]
          select: {
            exist: [
              "http_referer"
              "x_open_router_category"
              "x_open_router_title"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            header: [
              {
                kind: "header"
                name: "http_referer"
                orig: "http_referer"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "header"
                name: "x_open_router_category"
                orig: "x_open_router_category"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "header"
                name: "x_open_router_title"
                orig: "x_open_router_title"
                reqd: false
                type: "`$STRING`"
              }
            ]
            params: [
              {
                example: "job-abc123"
                kind: "param"
                name: "id"
                orig: "job_id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/videos/{jobId}"
          parts: [
            "videos"
            "{id}"
          ]
          rename: {
            param: {
              jobId: "id"
            }
          }
          select: {
            exist: [
              "http_referer"
              "id"
              "x_open_router_category"
              "x_open_router_title"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
