              }
            ]
            params: [
              {
                example: "1"
                kind: "param"
                name: "id"
                orig: "version"
                reqd: true
                type: "`$STRING`"
              }
              {
                example: "my-preset"
                kind: "param"
                name: "slug"
                orig: "slug"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/presets/{slug}/versions/{version}"
          parts: [
            "presets"
            "{slug}"
            "versions"
            "{id}"
          ]
          rename: {
            param: {
              version: "id"
            }
          }
          select: {
            exist: [
              "http_referer"
              "id"
              "slug"
              "x_open_router_category"
              "x_open_router_title"
            ]
          }
          transform: {
