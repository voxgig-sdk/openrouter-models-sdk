            source: "openapi3"
            version: 1
          }
          method: "GET"
          orig: "/activity"
          segments: [
            {
              lit: "activity"
            }
          ]
          select: {
            exist: [
              "api_key_hash"
              "date"
              "http_referer"
              "user_id"
