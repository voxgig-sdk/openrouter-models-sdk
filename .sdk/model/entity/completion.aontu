              {
                ex: "my-preset"
                k: "param"
                n: "slug"
                or: "slug"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "POST"
          o: "/presets/{slug}/chat/completions"
          q: {
            exist: [
              "http_referer"
              "slug"
              "x_open_router_category"
              "x_open_router_title"
            ]
          }
          s: [
            {
              lit: "presets"
            }
            {
              var: "slug"
            }
            {
              lit: "chat"
            }
            {
              lit: "completions"
            }
          ]
          t: {
