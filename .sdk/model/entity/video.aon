# Entity: video

main: kit: entity: video: {

  alias: field: {}

  fields: [
    {
      name: "aspect_ratio"
      req: false
      short: "Aspect ratio of the generated video"
      type: "`$STRING`"
    }
    {
      format: "uri"
      name: "callback_url"
      req: false
      short: "URL to receive a webhook notification when the video generation job completes."
      type: "`$STRING`"
    }
    {
      name: "duration"
      req: false
      short: "Duration of the generated video in seconds"
      type: "`$INTEGER`"
    }
    {
      name: "error"
      req: false
      type: "`$STRING`"
    }
    {
      name: "frame_images"
      req: false
      short: "Images to use as the first and/or last frame of the generated video."
      type: "`$ARRAY`"
    }
    {
      name: "generate_audio"
      req: false
      short: "Whether to generate audio alongside the video."
      type: "`$BOOLEAN`"
    }
    {
      name: "generation_id"
      req: false
      short: "The generation ID associated with this video generation job."
      type: "`$STRING`"
    }
    {
      name: "id"
      req: true
      type: "`$STRING`"
    }
    {
      name: "input_references"
      req: false
      short: "Reference assets to guide video generation."
      type: "`$ARRAY`"
    }
    {
      name: "model"
      req: true
      type: "`$STRING`"
    }
    {
      name: "polling_url"
      req: true
      type: "`$STRING`"
    }
    {
      name: "prompt"
      req: false
      short: "Text prompt describing the video to generate."
      type: "`$STRING`"
    }
    {
      name: "provider"
      req: false
      short: "Provider-specific passthrough configuration"
      type: "`$OBJECT`"
    }
    {
      name: "resolution"
      req: false
      short: "Resolution of the generated video"
      type: "`$STRING`"
    }
    {
      name: "seed"
      req: false
      short: "If specified, the generation will sample deterministically, such that repeated requests with the same seed and parameters should return the same result."
      type: "`$INTEGER`"
    }
    {
      name: "size"
      req: false
      short: "Exact pixel dimensions of the generated video in \"WIDTHxHEIGHT\" format (e.g."
      type: "`$STRING`"
    }
    {
      name: "status"
      req: true
      type: "`$STRING`"
    }
    {
      name: "unsigned_urls"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "usage"
      req: false
      short: "Usage and cost information for the video generation."
      type: "`$OBJECT`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "video"
  op: {
    create: {
      name: "create"
      points: [
        {
          args: {
            header: [
              {
                kind: "header"
                name: "http_referer"
                orig: "http_referer"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "header"
                name: "x_open_router_category"
                orig: "x_open_router_category"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "header"
                name: "x_open_router_title"
                orig: "x_open_router_title"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "POST"
          orig: "/videos"
          segments: [
            {
              lit: "videos"
            }
          ]
          select: {
            exist: [
              "http_referer"
              "x_open_router_category"
              "x_open_router_title"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            header: [
              {
                kind: "header"
                name: "http_referer"
                orig: "http_referer"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "header"
                name: "x_open_router_category"
                orig: "x_open_router_category"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "header"
                name: "x_open_router_title"
                orig: "x_open_router_title"
                reqd: false
                type: "`$STRING`"
              }
            ]
            params: [
              {
                example: "job-abc123"
                kind: "param"
                name: "id"
                orig: "job_id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/videos/{jobId}"
          rename: {
            param: {
              jobId: "id"
            }
          }
          segments: [
            {
              lit: "videos"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "http_referer"
              "id"
              "x_open_router_category"
              "x_open_router_title"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
