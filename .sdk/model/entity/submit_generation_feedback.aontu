# Entity: submit_generation_feedback

main: kit: entity: submit_generation_feedback: {

  alias: field: {}

  fields: [
    {
      name: "category"
      req: true
      type: "`$STRING`"
    }
    {
      name: "comment"
      req: false
      type: "`$STRING`"
    }
    {
      name: "data"
      req: true
      type: "`$OBJECT`"
    }
    {
      name: "generation_id"
      req: true
      type: "`$STRING`"
    }
  ]

  name: "submit_generation_feedback"
  op: {
    create: {
      name: "create"
      points: [
        {
          args: {
            header: [
              {
                kind: "header"
                name: "http_referer"
                orig: "http_referer"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "header"
                name: "x_open_router_category"
                orig: "x_open_router_category"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "header"
                name: "x_open_router_title"
                orig: "x_open_router_title"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "POST"
          orig: "/generation/feedback"
          parts: [
            "generation"
            "feedback"
          ]
          select: {
            exist: [
              "http_referer"
              "x_open_router_category"
              "x_open_router_title"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
