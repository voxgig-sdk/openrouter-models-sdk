# BasicPresetFlow

main: kit: flow: BasicPresetFlow:
{
  entity: "preset",
  kind: "basic",
  name: "BasicPresetFlow",
  step: [
    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "preset_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "preset_ref01",
        srcdatavar: "preset_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "preset01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-preset_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicPresetFlow"
}