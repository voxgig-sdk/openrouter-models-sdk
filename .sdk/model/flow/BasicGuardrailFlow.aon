# BasicGuardrailFlow

main: kit: flow: BasicGuardrailFlow:
{
  entity: "guardrail",
  kind: "basic",
  name: "BasicGuardrailFlow",
  step: [
    {
      input: {
        ref: "guardrail_ref01"
      }

      op: "create"
    }

    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "guardrail_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "guardrail_ref01",
        srcdatavar: "guardrail_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "guardrail01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-guardrail_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "guardrail_ref01",
        suffix: "_rm0"
      }

      match: {
        id: "guardrail01"
      }

      op: "remove"
    }

    {
      input: {
        suffix: "_rt0"
      }

      op: "list",
      valid: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "guardrail_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicGuardrailFlow"
}