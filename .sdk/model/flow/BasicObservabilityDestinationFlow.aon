# BasicObservabilityDestinationFlow

main: kit: flow: BasicObservabilityDestinationFlow:
{
  entity: "observability_destination",
  kind: "basic",
  name: "BasicObservabilityDestinationFlow",
  step: [
    {
      input: {
        ref: "observability_destination_ref01",
        srcdatavar: "observability_destination_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "observability_destination01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-observability_destination_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicObservabilityDestinationFlow"
}