# BasicVideoGenerationFlow

main: kit: flow: BasicVideoGenerationFlow:
{
  entity: "video_generation",
  kind: "basic",
  name: "BasicVideoGenerationFlow",
  step: [
    {
      input: {
        ref: "video_generation_ref01",
        srcdatavar: "video_generation_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "video_generation01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-video_generation_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicVideoGenerationFlow"
}