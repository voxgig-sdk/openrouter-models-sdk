# BasicEndpointFlow

main: kit: flow: BasicEndpointFlow:
{
  entity: "endpoint",
  kind: "basic",
  name: "BasicEndpointFlow",
  step: [
    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "endpoint_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "endpoint_ref01",
        srcdatavar: "endpoint_ref01_data",
        suffix: "_dt0"
      }

      match: {
        author: "author01",
        id: "endpoint01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-endpoint_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicEndpointFlow"
}